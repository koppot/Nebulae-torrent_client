; Syntax-validation harness for src-tauri/nsis/hooks.nsh.
;
; Mirrors the include scope and compile-time context of tauri-bundler 2.10.2's
; installer.nsi (template lines 22-36) so that every identifier the hooks use
; resolves exactly as it would in a real build. Not a functional installer.
;
; Run with NSIS 3.11 (the version tauri-bundler 2.10.2 downloads):
;   makensis -V2 hooks-harness.nsi
; Expected result: builds with zero errors; the only warnings are about MUI
; internals and the two template variables below, none of which the hooks own.
Unicode true
Name "hooks-harness"
OutFile "hooks-harness.exe"

!addincludedir "${__FILEDIR__}/../../../../src-tauri/nsis"

; --- same includes as installer.nsi (utils.nsh/FileAssociation.nsh omitted;
; --- they need tauri's Windows-only plugins and define nothing the hooks use
; --- beyond ERROR_MORE_DATA, stubbed below)
!include MUI2.nsh
!include FileFunc.nsh
!include x64.nsh
!include WordFunc.nsh
!include "Win\COM.nsh"
!include "Win\Propkey.nsh"
!include "Win\RestartManager.nsh"
!include "StrFunc.nsh"
; installer.nsi invokes ${StrLoc} here (template line 33); omitted in this
; harness because only the un.StrLoc variant (generated by hooks.nsh itself)
; is exercised.

; --- items installer.nsi / utils.nsh define before including the hooks
!define /ifndef ERROR_MORE_DATA 234
!define ARCH "x64"
Var /GLOBAL UpdateMode
Var /GLOBAL DeleteAppDataCheckboxState

!include "hooks.nsh"

Section "install-dummy"
  WriteUninstaller "$EXEDIR\un_hooks-harness.exe"
  !insertmacro NSIS_HOOK_PREINSTALL
  !insertmacro NSIS_HOOK_POSTINSTALL
SectionEnd

Section "un.uninstall-dummy"
  !insertmacro NSIS_HOOK_PREUNINSTALL
  !insertmacro NSIS_HOOK_POSTUNINSTALL
SectionEnd
