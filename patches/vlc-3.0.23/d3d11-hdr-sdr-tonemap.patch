+float GetFormatSourcePeak(const video_format_t *fmt)
+{
+    switch (fmt->transfer)
+    {
+        case TRANSFER_FUNC_SMPTE_ST2084:
+            /* static metadata: brightest pixel of the content, else the mastering display peak */
+            if (fmt->lighting.MaxCLL)
+                return (float)fmt->lighting.MaxCLL;
+            if (fmt->mastering.max_luminance)
+                return fmt->mastering.max_luminance / 10000.f; /* 0.0001 cd/m2 units */
+            return MAX_HLG_BRIGHTNESS; /* common mastering peak when nothing is signalled */
+        case TRANSFER_FUNC_HLG:
+            return MAX_HLG_BRIGHTNESS;
+        default:
             return DEFAULT_BRIGHTNESS;
     }
 }
