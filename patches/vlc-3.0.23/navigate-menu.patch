+/* Request the disc root / main menu (INPUT_NAV_MENU).
+ *
+ * Unlike libvlc_media_player_navigate() with libvlc_navigate_popup, which
+ * only sends a popup keystroke (BD_VK_POPUP for Blu-ray), this function
+ * directly invokes INPUT_NAV_MENU, which reaches:
+ *   - Blu-ray: bd_menu_call() (Top Menu / Root Menu)
+ *   - DVD:     dvdnav_menu_call() (Title/Root menu)
+ *
+ * This is a distinct exported symbol so callers can detect its presence
+ * at runtime against unmodified libVLC builds.
+ */
+void libvlc_media_player_navigate_menu( libvlc_media_player_t* p_mi )
+{
+    input_thread_t *p_input = libvlc_get_input_thread ( p_mi );
+    if ( p_input == NULL )
+        return;
+
+    input_Control( p_input, INPUT_NAV_MENU, NULL );
+    vlc_object_release( p_input );
+}
