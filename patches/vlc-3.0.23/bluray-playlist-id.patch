+/* Get the current Blu-ray MPLS playlist number from the input thread's
+ * "bluray-playlist-id" variable, which is written by the bluray access
+ * demuxer (modules/access/bluray.c) on every BD_EVENT_PLAYLIST event.
+ *
+ * Returns -1 if the variable does not exist (non-Blu-ray media or no
+ * playlist has started yet) or when the player is not playing.
+ */
+int libvlc_media_player_get_bluray_playlist_id( libvlc_media_player_t* p_mi )
+{
+    input_thread_t *p_input = libvlc_get_input_thread ( p_mi );
+    if ( p_input == NULL )
+        return -1;
+
+    int i_val = -1;
+    if ( var_Type( p_input, "bluray-playlist-id" ) & VLC_VAR_INTEGER )
+        i_val = (int)var_GetInteger( p_input, "bluray-playlist-id" );
+
+    vlc_object_release( p_input );
+    return i_val;
+}
