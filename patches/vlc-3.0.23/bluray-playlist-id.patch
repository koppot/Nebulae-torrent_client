+/**
+ * Get the current Blu-ray MPLS playlist number (0–99999).
+ *
+ * Returns the numeric part of the currently active ?????.mpls filename as
+ * reported by libbluray's BD_EVENT_PLAYLIST event.  This value is set on the
+ * input thread's "bluray-playlist-id" variable every time a new playlist
+ * begins playing (BD_EVENT_PLAYLIST fires), and is therefore available for
+ * the entire duration of that playlist's playback.
+ *
+ * Returns -1 when no Blu-ray playlist is active, when the demuxer has not
+ * yet received BD_EVENT_PLAYLIST, or when the media is not a Blu-ray disc.
+ *
+ * \param p_mi media player
+ */
+LIBVLC_API int libvlc_media_player_get_bluray_playlist_id( libvlc_media_player_t* p_mi );
