+/* Get the Blu-ray interactive-menu visibility from the input thread's
+ * "bluray-menu-open" variable, which is written by the bluray access
+ * demuxer (modules/access/bluray.c) on every BD_EVENT_MENU event. Unlike
+ * the current-title report, this state comes from the disc's graphics
+ * controller, so it only reports a menu that is actually displayed and
+ * accepting input; a title request the disc's VM refused never sets it.
+ *
+ * Returns 1 while an interactive menu (top menu, popup, BD-J OSD) is
+ * displayed, 0 while none is, and -1 when the variable does not exist
+ * (non-Blu-ray media) or the player is not playing.
+ */
+int libvlc_media_player_get_bluray_menu_open( libvlc_media_player_t* p_mi )
+{
+    input_thread_t *p_input = libvlc_get_input_thread ( p_mi );
+    if ( p_input == NULL )
+        return -1;
+
+    int i_val = -1;
+    if ( var_Type( p_input, "bluray-menu-open" ) & VLC_VAR_INTEGER )
+        i_val = (int)var_GetInteger( p_input, "bluray-menu-open" );
+
+    vlc_object_release( p_input );
+    return i_val;
+}
