 /*****************************************************************************
+ * blurayTopMenuCall: request the top menu even while the disc masks it
+ *
+ * Warning/intro clips commonly mask the menu-call UO while they play, which
+ * makes a menu request a silent no-op until the footage ends. Lower the UO
+ * restriction enforcement only around this navigation call, so seeks and
+ * stream selection keep upstream mask enforcement.
+ *****************************************************************************/
+static int blurayTopMenuCall(demux_t *p_demux)
+{
+    demux_sys_t *p_sys = p_demux->p_sys;
+    int result;
+
+    bd_set_player_setting(p_sys->bluray, BLURAY_PLAYER_SETTING_UO_RESTRICTION_LEVEL,
+                          BLURAY_PLAYER_SETTING_UO_RESTRICTION_DISABLED);
+    result = bd_menu_call(p_sys->bluray, -1);
+    bd_set_player_setting(p_sys->bluray, BLURAY_PLAYER_SETTING_UO_RESTRICTION_LEVEL,
+                          BLURAY_PLAYER_SETTING_UO_RESTRICTION_RELAXED);
+    return result;
+}
