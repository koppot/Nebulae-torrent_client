# Nebulae Server — rtorrent configuration (beta)
# Loaded as /root/.rtorrent.rc inside the container.

# Storage layout (all under the /data volume)
directory.default.set = /data/downloads
session.path.set = /data/session
schedule = watch_directory,5,5,load.start=/data/watch/*.torrent
schedule = session_save,240,300,session.save=

# SCGI socket for the Nebulae bridge (loopback inside the container only;
# it is never published)
scgi_local = /run/rtorrent/scgi.sock

# BitTorrent listening port (single fixed port, published by the container)
network.port_range.set = 6881-6881
network.port_random.set = no

# Swarm features
dht.mode.set = auto
protocol.pex.set = yes
trackers.use_udp.set = yes

# No global rate limits; the desktop app controls per-torrent throttles
throttle.global.down.max.set = 0
throttle.global.up.max.set = 0

encoding.add = UTF-8
