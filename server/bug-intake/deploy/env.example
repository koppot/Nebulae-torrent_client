# Nebulae bug-report intake service: environment (placeholders only).
# Install as /etc/nebulae-reports/env, owner root:nebulae-reports, mode 0640. Never commit real values.

DB_DSN=mysql:host=127.0.0.1;dbname=nebulae_reports;charset=utf8mb4
DB_USER=nebulae_reports
DB_PASS=__GENERATED_DATABASE_PASSWORD__

STORAGE_DIR=/var/lib/nebulae-reports
LOG_FILE=/var/log/nebulae-reports/intake.log

# Emergency switch: set to 1 (or run `admin.php disable`) to refuse new reports with a clear message.
INTAKE_DISABLED=0

# 32+ random characters each (e.g. `openssl rand -hex 32`). Rotating RECEIPT_HMAC_KEY invalidates outstanding receipt tokens.
RECEIPT_HMAC_KEY=__RANDOM_HEX__
IP_HASH_KEY=__RANDOM_HEX__

# Linear: a dedicated API key for the service (not a personal key of a maintainer if avoidable).
LINEAR_API_KEY=__LINEAR_API_KEY__
LINEAR_TEAM_ID=9b9b7b16-a5bb-4ab9-861f-6ee655d6ac58
LINEAR_PROJECT_ID=ed29b395-4bbf-407c-af44-3ee0bbcfdba7
# Backlog state of team ASI (no Triage state exists today)
LINEAR_INTAKE_STATE_ID=24657a4f-6dbe-4981-bf5a-8008c601e5b1
# Bug, user-report, needs-triage label ids (comma separated)
LINEAR_LABEL_IDS=114226c8-b0f6-4c75-8869-8e2be0f8a5ee,02159c70-e982-4af2-9cf8-84112f419e6a,1287d797-7ca3-4df7-9c1d-4e24ddfd7933

# Discord: webhook of the private bugs channel (kept server-side only).
DISCORD_BUGS_WEBHOOK_URL=__DISCORD_WEBHOOK_URL__
DISCORD_BUGS_CHANNEL_ID=__CHANNEL_ID__
DISCORD_GUILD_ID=__GUILD_ID__
DISCORD_MAX_MESSAGE_BYTES=8000000

# Limits
MAX_SCREENSHOTS=5
MAX_SCREENSHOT_BYTES=10485760
MAX_TOTAL_BYTES=26214400
STORAGE_QUOTA_BYTES=21474836480
RATE_PER_IP_HOUR=6
RATE_PER_IP_DAY=20
RATE_GLOBAL_DAY=500
MAX_OPEN_REPORTS=2000

# Retention (days)
RETENTION_ATTACHMENT_DAYS=30
RETENTION_REPORT_DAYS=365
RETENTION_CONTACT_DAYS=90

# Restricted contact storage
CONTACT_KEY_FILE=/etc/nebulae-reports/contact.key
MAINTAINERS_FILE=/etc/nebulae-reports/maintainers

# Cloudflare proxy ranges (https://www.cloudflare.com/ips/); CF-Connecting-IP is trusted only from these peers.
TRUSTED_PROXY_CIDRS=173.245.48.0/20,103.21.244.0/22,103.22.200.0/22,103.31.4.0/22,141.101.64.0/18,108.162.192.0/18,190.93.240.0/20,188.114.96.0/20,197.234.240.0/22,198.41.128.0/17,162.158.0.0/15,104.16.0.0/13,104.24.0.0/14,172.64.0.0/13,131.0.72.0/22,2400:cb00::/32,2606:4700::/32,2803:f800::/32,2405:b500::/32,2405:8100::/32,2a06:98c0::/29,2c0f:f248::/32
