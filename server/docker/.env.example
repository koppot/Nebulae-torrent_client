# Copy to .env (never commit .env). Placeholders only.

# REQUIRED. API token the Nebulae desktop client sends as "Authorization: Bearer <token>".
# Generate one with:  openssl rand -hex 32
NEBULAE_TOKEN=change-me-to-a-long-random-token

# Optional. Image tag to run (0.2.8 is the release this file ships with).
#NEBULAE_TAG=0.2.8
# Optional. Host port for the bridge API (default 9174). The peer port is fixed at 51413 TCP+UDP.
#NEBULAE_HOST_PORT=9174

# Optional. Use host paths instead of named volumes (the container user is switched to PUID/PGID).
#DOWNLOAD_DIR=/mnt/user/media/downloads
#WATCH_DIR=/mnt/user/media/watch
#PUID=1000
#PGID=1000

# Optional. Recorded in the image when building from source: BUILD_ID=$(git rev-parse HEAD)
#BUILD_ID=
